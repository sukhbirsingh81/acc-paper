# vim: set syn=perl :
# https://tex.stackexchange.com/questions/1226/how-to-make-latexmk-use-makeglossaries#44316

add_cus_dep('glo', 'gls', 0, 'run_makeglossaries');
add_cus_dep('acn', 'acr', 0, 'run_makeglossaries');
add_cus_dep('syg', 'syi', 0, 'run_makeglossaries');

sub run_makeglossaries {
  if ( $silent ) {
    system(qw(makeglossaries -q), $_[0]);
  }
  else {
    system(qw(makeglossaries), $_[0]);
  };
}

